{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "harat-almafia",
  "account_id": "d2da02b7c54b5e62faa9ca8aaa71e935",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/games/*", "/robots.txt", "/sitemap.xml"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qinaa-production",
      "database_id": "098a25a9-7cc8-49aa-8e38-3a68842d3cf2",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOM_CHAT", "class_name": "RoomChat" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomChat"] }
  ]
}
