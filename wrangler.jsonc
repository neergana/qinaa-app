{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "harat-almafia",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qinaa-production",
      "database_id": "098a25a9-7cc8-49aa-8e38-3a68842d3cf2",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOM_CHAT", "class_name": "RoomChat" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomChat"] }
  ]
}
